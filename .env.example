# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://username:password@host:port/database

# Optional: Set to 'production' to enable SSL
NODE_ENV=development

# AI
ANTHROPIC_API_KEY=your_anthropic_key

# Website Hosting
VERCEL_TOKEN=your_vercel_token

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_key

# Stripe (payments + billing)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_CLIENT_ID=ca_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# Square (payments + tap-to-pay)
SQUARE_APPLICATION_ID=sq0idp-...
SQUARE_APPLICATION_SECRET=sq0csp-...
SQUARE_WEBHOOK_SIGNATURE_KEY=your_signature_key
SQUARE_ENVIRONMENT=production

# PayPal (payments)
PAYPAL_WEBHOOK_ID=your_webhook_id

# Google (GBP Profile Analyzer — Places API)
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Frontend URL (for payment links, redirects)
FRONTEND_URL=https://sorceintegrations.com
